# Copy to backend/.env and adjust. Every value below is the default.
# No API key is required: only public market-data endpoints are used and no orders are ever placed.

# --- market data ---------------------------------------------------------------------------------
EXCHANGE=binance                 # any CCXT id: binance, bybit, okx, kraken, coinbase ... or "csv" (see CSV_DIR)
DERIVATIVES_EXCHANGE=binanceusdm # funding / open interest venue; leave empty to disable
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,SUI/USDT
CSV_DIR=./data/csv               # used when EXCHANGE=csv: files named BTCUSDT_4h.csv etc.
ENABLE_WEBSOCKET_FEED=true       # false = REST polling only
ENABLE_EXTERNAL_CONTEXT=true     # CoinGecko global stats + alternative.me Fear & Greed (free, no key)

# --- storage -------------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/crypto_ai.db
# DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto_ai
MODEL_DIR=./data/models

# --- cadence -------------------------------------------------------------------------------------
ENABLE_BACKGROUND_JOBS=true
CANDLE_REFRESH_S=60              # candle sync
FORECAST_REFRESH_S=300           # inference only; also changeable in the UI (1/5/15/30/60 min)
RETRAIN_INTERVAL_H=168           # retrain each model weekly

# --- modelling -----------------------------------------------------------------------------------
ENABLE_DEEP_MODELS=false         # LSTM / GRU / Transformer (needs requirements-dl.txt)
NEUTRAL_BAND_SIGMA=0.25          # |next-bar return| below this many bar-sigmas is labelled NEUTRAL
MIN_TRAIN_SAMPLES=150
MIN_OOS_FOR_EDGE=300             # out-of-sample predictions needed before an edge can be confirmed
EDGE_ALPHA=0.01                  # significance level of the edge test

# --- signal policy -------------------------------------------------------------------------------
REQUIRE_EDGE_FOR_ML=true         # ML probability only enters the signal score once its edge is confirmed
REQUIRE_EDGE_FOR_TRADE=false     # true = every decision is NO TRADE until the model's edge is confirmed
MIN_CONFIDENCE=0.45              # 3-class hit-rate scale: pure chance is roughly 0.40
MIN_MODEL_AGREEMENT=0.60
MIN_RISK_REWARD=1.5

# --- costs used by backtests, the edge test and paper trading -------------------------------------
FEE_RATE=0.001                   # per side
SLIPPAGE_BPS=2
SPREAD_BPS=1

CORS_ORIGINS=http://localhost:5173
