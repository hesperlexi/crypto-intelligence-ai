rules_version = '2';
// Generated at deploy time from firestore.rules.template: __ADMIN_EMAILS__ is replaced with the
// ADMIN_EMAILS repository variable. Only those Google accounts can read or change anything.
// The engine writes with a service account, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [__ADMIN_EMAILS__];
    }
    match /views/{id}        { allow read: if allowed(); allow write: if false; }
    match /config/{id}       { allow read, write: if allowed(); }
    match /alerts/{id}       { allow read, write: if allowed(); }
    match /jobs/{id} {
      allow read: if allowed();
      allow create: if allowed() && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }
    match /paper/{id}        { allow read, write: if allowed(); }
    match /paper_trades/{id} { allow read, create: if allowed(); allow update, delete: if false; }
  }
}
