rules_version = '2';
// Generated at deploy time from firestore.rules.template: __ADMIN_EMAILS__ is replaced with the
// ADMIN_EMAILS repository variable. The engine writes with a service account, which bypasses these rules.
//
// Roles
//   admin   - Google accounts listed in ADMIN_EMAILS: everything, including coins, bots, settings and users
//   member  - approved by the admin and membership not ended (users/{uid}.expires_at): reads the predictions, and has
//             their own paper accounts, alerts and notification devices
//   pending - signed in and asked for access; can only see their own request
// Sign-in: Google or email + password. Email accounts count as signed in only once the address is verified.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [__ADMIN_EMAILS__];
    }
    // approved and the membership has not ended (no end date = approved before memberships existed)
    function activeRecord(u) {
      return u.status == 'approved'
        && (!('expires_at' in u) || u.expires_at == null || u.expires_at > request.time.toMillis());
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && activeRecord(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }
    function allowed() { return isAdmin() || isMember(); }
    function me() { return request.auth.uid; }
    // usernames: 3-20 of a-z 0-9 _, stored lower-case; names of staff / the brand are kept for the admin
    function validUsername(n) {
      return n is string && n.matches('^[a-z0-9_]{3,20}$')
        && (isAdmin() || (!(n in ['admin', 'administrator', 'support', 'crypto', 'cryptointelai', 'cryptointel', 'hesper', 'moderator', 'mod',
              'root', 'system', 'owner', 'staff', 'team', 'official', 'help', 'security', 'null', 'undefined', 'anonymous', 'everyone'])
            && !n.matches('.*(admin|support|moderator|cryptointel).*')));
    }
    // a payment screenshot: an image data URL (PNG, JPEG or WebP, base64) under ~900 KB; anything else is refused
    function validProof(p) {
      return p is string && p.size() < 900000 && p.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$');
    }
    // the proof field inside a payment map: missing, null or a valid image
    function proofOk(pay) {
      return !('proof' in pay) || pay.proof == null || validProof(pay.proof);
    }
    // v2.16 referrals: a member's invite code is 8 characters a-z / 0-9 (ref_codes/{code}, users/{uid}.ref_code)
    function validRefCode(c) { return c is string && c.matches('^[a-z0-9]{8}$'); }
    // a new account opened from an invite link: referred_by = the referrer's uid, ref_via = their code. Both or neither;
    // the code must exist and belong to that uid, and nobody can refer themselves. Only at creation (see users update).
    function validReferral(d) {
      return (!('referred_by' in d) && !('ref_via' in d))
        || (d.referred_by is string && d.referred_by != me() && validRefCode(d.ref_via)
            && exists(/databases/$(database)/documents/ref_codes/$(d.ref_via))
            && get(/databases/$(database)/documents/ref_codes/$(d.ref_via)).data.uid == d.referred_by);
    }
    // optional string field of at most 64 characters (null allowed)
    function shortText(d, k) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= 64);
    }

    // admin probe: the website reads this to know whether the signed-in account is an admin
    match /admin/{id}        { allow read: if isAdmin(); allow write: if false; }
    // owner-only settings (e.g. the Telegram bot token): members can neither read nor write them
    match /owner/{id}        { allow read: if isAdmin(); allow write: if isAdmin() && id != 'telegram_status'; }

    // access requests, membership and payment proofs
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      // only the fields the website writes (frontend/src/lib/session.tsx and membership.ts); proof size capped
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'photo', 'status', 'requested_at', 'payment', 'provider', 'referred_by', 'ref_via'])
        && validReferral(request.resource.data)
        && (!('provider' in request.resource.data) || request.resource.data.provider in ['google', 'password'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && (!('uid' in request.resource.data) || request.resource.data.uid == me())
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 2048))
        && (!('payment' in request.resource.data) || (request.resource.data.payment.status == 'submitted'
            && proofOk(request.resource.data.payment)));
      // the person may only send (or replace) a payment proof, and choose a username once (together with its
      // usernames/{name} claim, see below); status, end date and history stay with the admin
      allow update: if isAdmin() || (signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment'])
        && request.resource.data.payment.status == 'submitted'
        && proofOk(request.resource.data.payment))
        || (signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && !('username' in resource.data)
        && validUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == me())
        // v2.16: an active member sets their invite code once, together with its ref_codes/{code} claim. Nothing else
        // about referrals or rewards (referred_by, referral_reward, referral_stats, history, expires_at, badges) is ever
        // writable by the member: free months and badges come only from the admin (or the engine).
        || (isMember() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ref_code'])
        && !('ref_code' in resource.data)
        && validRefCode(request.resource.data.ref_code)
        && getAfter(/databases/$(database)/documents/ref_codes/$(request.resource.data.ref_code)).data.uid == me());
      allow delete: if isAdmin();
    }

    // v2.16 invite codes: one per member (users/{uid}.ref_code is write-once), never changed. Anyone signed in may look
    // up one code (a new account checks whose link it came from); nobody may list them.
    match /ref_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isMember() && validRefCode(code)
        && request.resource.data.keys().hasOnly(['uid', 'created_at'])
        && request.resource.data.uid == me()
        && request.resource.data.created_at is number
        && getAfter(/databases/$(database)/documents/users/$(me())).data.get('ref_code', null) == code;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // payment screenshots (since v2.1, Oct 2026) live here instead of inside users/{uid}.payment, so the admin's Users
    // list does not download every image: the person writes their own, the admin reads one when opening the proof
    // viewer. Older proofs stay inline in users/{uid}.payment.proof and are still shown.
    match /payment_proofs/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['uid', 'proof', 'submitted_at'])
        && request.resource.data.uid == me()
        && validProof(request.resource.data.proof)
        && request.resource.data.submitted_at is number;
      allow delete: if isAdmin();
    }

    // the username a person posts under: users/{uid}.username, or for the owner (no users record) owner/profile.username
    function myUsername() {
      return isAdmin() && exists(/databases/$(database)/documents/owner/profile)
        ? get(/databases/$(database)/documents/owner/profile).data.get('username', null)
        : (exists(/databases/$(database)/documents/users/$(me()))
          ? get(/databases/$(database)/documents/users/$(me())).data.get('username', null) : null);
    }
    // one document per username (lower-case): who owns it. Created together with users/{uid}.username (or the owner's
    // owner/profile), never changed; anyone signed in may look up one name (to say "taken"), nobody may list them
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'created_at'])
        && request.resource.data.uid == me()
        && request.resource.data.created_at is number
        && ((isAdmin() && getAfter(/databases/$(database)/documents/owner/profile).data.get('username', null) == name)
          || getAfter(/databases/$(database)/documents/users/$(me())).data.get('username', null) == name);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Community: members' posts. Text only (1-500 characters), signed with the author's username, never edited;
    // the author or the admin may delete. At most one post per 30 seconds per person: each post also moves
    // post_meta/{uid}.last to the post's time, and that document only moves forward in steps of 30 s or more.
    // The post id is <uid>_<created_at>, so one batch cannot add a second post under the same post_meta step.
    function nowMs() { return request.time.toMillis(); }
    match /posts/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && id == me() + '_' + string(request.resource.data.created_at)
        && request.resource.data.keys().hasOnly(['author_uid', 'username', 'text', 'created_at', 'admin'])
        && request.resource.data.keys().hasAll(['author_uid', 'username', 'text', 'created_at'])
        && request.resource.data.author_uid == me()
        && request.resource.data.username is string
        && request.resource.data.username == myUsername()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.text.matches('(?s).*[^\\s].*')
        && request.resource.data.created_at is number
        && request.resource.data.created_at > nowMs() - 120000 && request.resource.data.created_at < nowMs() + 120000
        && (!('admin' in request.resource.data) || request.resource.data.admin == isAdmin())
        && getAfter(/databases/$(database)/documents/post_meta/$(me())).data.last == request.resource.data.created_at;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.author_uid == me());
    }
    match /post_meta/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if allowed() && me() == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is number
        && request.resource.data.last > nowMs() - 120000 && request.resource.data.last < nowMs() + 120000;
      allow update: if allowed() && me() == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is number
        && request.resource.data.last > nowMs() - 120000 && request.resource.data.last < nowMs() + 120000
        && request.resource.data.last >= resource.data.last + 30000;
      allow delete: if false;
    }

    // the admin's scalping scorecard (views/scalping): admin only, unless the admin set config/scalping.visibility
    // (setting `scalping_visibility`) to 'members' - then active members too. Never public or signed-out.
    function scalpingForMembers() {
      return exists(/databases/$(database)/documents/config/scalping)
        && get(/databases/$(database)/documents/config/scalping).data.get('visibility', 'admin') == 'members';
    }
    // Hesper challenge (views/hesper, Road to Rich): admin only, unless the admin set config/hesper.visibility to
    // 'members' - then active members too (view only). Never public or signed-out.
    function hesperForMembers() {
      return exists(/databases/$(database)/documents/config/hesper)
        && get(/databases/$(database)/documents/config/hesper).data.get('visibility', 'admin') == 'members';
    }
    // engine output; per-member alert views are private to that member
    // wins_today is public (the sign-in page shows it); scalping as above; hesper as above;
    // health_errors (raw engine error texts, v2.13) and guardian (v2.19 Trade Guardian recommendations) are admin only;
    // everything else is for members
    match /views/{id} {
      allow read: if id == 'wins_today'
        || (id == 'scalping' && (isAdmin() || (isMember() && scalpingForMembers())))
        || (id == 'hesper' && (isAdmin() || (isMember() && hesperForMembers())))
        || (id == 'health_errors' && isAdmin())
        || (id == 'guardian' && isAdmin())
        || (id != 'scalping' && id != 'hesper' && id != 'health_errors' && id != 'guardian' && allowed()
            && (!id.matches('alerts_u_.*') || isAdmin() || id == 'alerts_u_' + me()));
      allow write: if false;
    }
    // coins, bots, settings: everyone signed in may read, only the admin may change
    // membership: prices, payment note and support email are public (the landing page shows them)
    // scalping, hesper: {visibility: 'admin' | 'members', updated_at, by} - only these fields, written by the admin
    match /config/{id} {
      allow read: if allowed() || id == 'membership';
      allow write: if isAdmin() && ((id != 'scalping' && id != 'hesper') || (
        request.resource.data.keys().hasOnly(['visibility', 'updated_at', 'by'])
        && request.resource.data.visibility in ['admin', 'members']));
    }
    // coins a member follows for themselves (the engine tracks them while the membership is active)
    // how many coins one member may add: config/limits.member_coin_limit (set by the admin; default 5)
    function coinLimit() {
      return exists(/databases/$(database)/documents/config/limits)
        ? get(/databases/$(database)/documents/config/limits).data.get('member_coin_limit', 5) : 5;
    }
    match /user_coins/{uid} {
      allow read: if allowed() && (isAdmin() || me() == uid);
      allow write: if allowed() && me() == uid
        && request.resource.data.symbols is list && request.resource.data.symbols.size() <= coinLimit();
      allow delete: if isAdmin() || (allowed() && me() == uid);
    }
    // per-user small state (e.g. which alerts were read)
    match /user_state/{uid}  { allow read, write: if allowed() && (isAdmin() || me() == uid); }
    // last activity, approximate country (from the time zone) and device type: written by the person, read by the owner
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['last_seen', 'at', 'country', 'tz', 'device'])
        && (!('last_seen' in request.resource.data) || request.resource.data.last_seen is number)
        && (!('at' in request.resource.data) || request.resource.data.at is number)
        && shortText(request.resource.data, 'country') && shortText(request.resource.data, 'tz')
        && shortText(request.resource.data, 'device');
    }

    // an alert rule exactly as the website writes it (frontend/src/lib/api.ts "POST /alerts"); the engine skips anything
    // else too (worker.alert_row), but a malformed rule never gets in here in the first place
    function validAlert(d) {
      return d.keys().hasOnly(['type', 'symbol', 'timeframe', 'params', 'cooldown_s', 'enabled', 'created_at', 'owner_uid', 'owner_email'])
        && d.keys().hasAll(['type', 'symbol', 'owner_uid'])
        && d.type in ['TRADE_SETUP', 'BUY_SIGNAL', 'SELL_SIGNAL', 'BULLISH_REGIME', 'BEARISH_REGIME', 'BREAKOUT', 'BREAKDOWN',
                      'TARGET_REACHED', 'STOP_REACHED', 'CONFIDENCE_ABOVE', 'VOLATILITY_SPIKE', 'PRICE_ABOVE', 'PRICE_BELOW',
                      // v2.16 smarter alerts: call events (symbol ALL/USDT = every coin, timeframe 'all') and market mood
                      'ENTRY_REACHED', 'TP2_REACHED', 'TP3_REACHED', 'SIGNAL_CLOSED', 'SIGNAL_UPDATES', 'MOOD_CHANGE']
        && d.symbol is string && d.symbol.matches('^[A-Z0-9]{1,20}/[A-Z0-9]{2,10}$')
        && (!('timeframe' in d) || d.timeframe in ['1m', '5m', '15m', '30m', '1h', '4h', '12h', '1d', '3d', '1w', 'all'])
        && (!('params' in d) || (d.params is map && d.params.size() <= 12))
        && (!('cooldown_s' in d) || (d.cooldown_s is int && d.cooldown_s >= 60 && d.cooldown_s <= 31536000))
        && (!('enabled' in d) || d.enabled is bool)
        && (!('created_at' in d) || d.created_at is number)
        && d.owner_uid is string
        && (!('owner_email' in d) || d.owner_email == null || (d.owner_email is string && d.owner_email.size() <= 320));
    }
    match /alerts/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.owner_uid == me());
      allow create: if validAlert(request.resource.data)
        && (isAdmin() || (isMember() && request.resource.data.owner_uid == me()));
      // the website only switches a rule on / off
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled'])
        && request.resource.data.enabled is bool
        && (isAdmin() || (isMember() && resource.data.owner_uid == me()));
      allow delete: if isAdmin() || (isMember() && resource.data.owner_uid == me());
    }
    match /jobs/{id} {
      // a job (and its result) is read by the person who queued it, or by the admin
      allow read: if isAdmin() || (allowed() && resource.data.by == request.auth.token.email);
      // signed by the person's own address (by), created_at a number, small params; a member's test notification may
      // only target themselves (the engine also sends it only to the job owner, and limits jobs per person per day)
      allow create: if signedIn()
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.status == 'queued'
        && request.resource.data.created_at is number
        && (!('params' in request.resource.data) || (request.resource.data.params is map && request.resource.data.params.size() <= 24))
        && (isAdmin() || (isMember() && request.resource.data.type in ['backtest', 'replay', 'test_push']
            && (request.resource.data.type != 'test_push'
                || ('params' in request.resource.data && 'uid' in request.resource.data.params
                    && request.resource.data.params.uid == me()))));
      allow update, delete: if false;
    }
    // auto-trading of signals into the member's own paper account: settings by the member, log by the engine
    match /auto_paper/{uid}       { allow read, write: if isAdmin() || (isMember() && uid == me()); }
    match /auto_paper_state/{uid} { allow read: if isAdmin() || (isMember() && uid == me()); allow write: if false; }
    // paper accounts: members only touch documents named after their own uid.
    // v2.14 "Add funds" (frontend/src/lib/writeShapes.ts paperTopUp / newPaperFields): a new or reset account (new `id`)
    // starts with 0 < starting_balance <= $1,000,000, deposited == starting_balance, deposit_count 0. On the same account
    // starting_balance never changes and `deposited` (total virtual USDT put in) never goes down; a top-up raises it by a
    // positive amount to at most $1,000,000, raises deposit_count by exactly one and adds the same amount to the balance
    // (futures `wallet` / spot `cash`); otherwise deposit_count stays. The trading itself stays the member's own app code.
    function paperDep(d) { return d.get('deposited', d.get('starting_balance', 0)); }
    function paperFunds(d) { return d.get('wallet', d.get('cash', 0)); }
    function paperNewAccount(n) {
      return n.get('starting_balance', 0) is number && n.get('starting_balance', 0) > 0
        && n.get('starting_balance', 0) <= 1000000 && paperDep(n) == n.get('starting_balance', 0)
        && n.get('deposit_count', 0) == 0 && n.get('deposits', []) is list && n.get('deposits', []).size() == 0;
    }
    function paperSameAccount(n, o) {
      return n.get('starting_balance', 0) == o.get('starting_balance', 0)
        && n.get('deposits', []) is list && n.get('deposits', []).size() <= 50
        && ((paperDep(n) == paperDep(o) && n.get('deposit_count', 0) == o.get('deposit_count', 0))
            || (paperDep(n) is number && paperDep(n) > paperDep(o) && paperDep(n) <= 1000000
                && n.get('deposit_count', 0) == o.get('deposit_count', 0) + 1
                && math.abs((paperFunds(n) - paperFunds(o)) - (paperDep(n) - paperDep(o))) < 0.01));
    }
    function validPaper() {
      return (resource == null && paperNewAccount(request.resource.data))
        || (resource != null && request.resource.data.get('id', '') != resource.data.get('id', '')
            && paperNewAccount(request.resource.data))
        || (resource != null && request.resource.data.get('id', '') == resource.data.get('id', '')
            && paperSameAccount(request.resource.data, resource.data));
    }
    match /paper/{id} {
      allow read, delete: if isAdmin() || (isMember() && id.matches(me() + '_.*'));
      allow create, update: if isAdmin() || (isMember() && id.matches(me() + '_.*') && validPaper());
    }
    match /paper_trades/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == me());
      allow create: if isAdmin() || (isMember() && request.resource.data.uid == me());
      allow update, delete: if false;
    }
    match /paper_futures_trades/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == me());
      allow create: if isAdmin() || (isMember() && request.resource.data.uid == me());
      allow update, delete: if false;
    }
    match /push_tokens/{id} {
      allow read, delete: if isAdmin() || (signedIn() && resource.data.uid == me());
      allow create: if allowed() && request.resource.data.uid == me();
      allow update: if allowed() && request.resource.data.uid == me() && resource.data.uid == me();
    }
  }
}
